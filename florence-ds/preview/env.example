# Clerk — https://dashboard.clerk.com
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...

# Billing must be enabled: Dashboard → Billing → Settings (or `clerk enable billing --for user`)
# Pro user plan slug from Dashboard → Billing → Plans
VITE_CLERK_PRO_PLAN_SLUG=pro

# Optional: plan ID (cplan_...) if auto-detection fails. Copy from Dashboard → Billing → Plans.
# VITE_CLERK_PRO_PLAN_ID=

# Dev only: comma-separated emails that get Pro without checkout (founder/testing).
# VITE_PRO_BYPASS_EMAILS=john@humanai.studio.io,john@humanaistudio.io
