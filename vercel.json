    {
      "source": "/websites",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/offerings/:path*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/beta/",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/playbook/",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/florence/system/",
      "destination": "/florence/system",
      "permanent": true
    }
